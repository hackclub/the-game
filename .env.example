DATABASE_URL="postgres://postgres:password@localhost:5432/game_development"

# By default, this is https://auth.hackclub.com. However, in a development environment, you probably want to use https://hca.dinosaurbbq.org/
# instead, which is our staging instance.
HCA_URL="https://auth.hackclub.com"

# You need these to log in!
# In order to set these up:
#   - enable developer mode in https://hca.dinosaurbbq.org/identity/edit
#   - go to https://hca.dinosaurbbq.org/developer/apps
#   - create an app, name it something like "Hack Club: The Game (Mock Environment)"
#   - set redirect URI to http://localhost:3100/auth/hca/callback
#   - copy both variables
# If you're using the production HCA server, replace hca.dinosaurbbq.org with auth.hackclub.com.
ACCOUNT_CLIENT_ID=""
ACCOUNT_CLIENT_SECRET=""
