<div class="flex items-center justify-center min-h-screen">
  <%= render "shared/card", class: "flex flex-col items-center w-full max-w-2xl justify-center min-h-screen px-4 space-y-12 md:p-12 md:min-h-auto" do %>
    <div class="text-center space-y-2">
      <h1 class="text-4xl pb-2">One final step!</h1>
      <p>Hack Club: The Game is for teenagers 13 - 18 only.</p>
      <p>19 and older? You can still join and refer a teen for a chance to win a GPU.</p>
    </div>
    
    <%= form_with url: age_verification_path, method: :post, class: "w-full space-y-6" do |f| %>
      <div class="space-y-2">
        <label for="birthday" class="block text-lg font-medium text-center">When's your birthday?</label>
        <div class="relative w-full flex flex-col items-center">
          <%= f.date_field :birthday, 
            required: true,
            class: "input px-12 text-white bg-bp-darker border-2 border-white placeholder-white/50 [color-scheme:dark]",
            placeholder: "Select your birthday" %>
        </div>
      </div>

      <div class="flex justify-center">
        <%= render "shared/button", text: "Continue", variant: :primary, html_options: { type: "submit" } %>
      </div>
    <% end %>
    
  <% end %>
</div>